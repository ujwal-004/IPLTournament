# Database connection
IPL_DB_URL=jdbc:mysql://localhost:3306/ipl_tournament?useSSL=false&serverTimezone=UTC
IPL_DB_USER=root
IPL_DB_PASSWORD=your_local_mysql_password

# The first administrator is created on servlet startup if these are set.
IPL_ADMIN_USERNAME=admin
IPL_ADMIN_PASSWORD=choose_a_private_password_of_at_least_12_characters
